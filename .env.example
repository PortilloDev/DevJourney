APP_NAME=DevJourney
APP_ENV=local
APP_KEY=base64:Nw4hSPg5YNj1eC73JOYaRlyCnhGBMbvevPDbD9gl3hY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Canonical origin the browser uses (scheme://host[:port]). Laravel forces this
# as the root URL, so it MUST include the port in dev (e.g. http://localhost:8002)
# or links/redirects will point to http://localhost without it.
APP_URL=http://localhost

# Origin the browser uses to load assets. Docker delivers requests to the
# container with a portless Host, so without this asset() emits
# http://localhost/build/... and assets fail (ERR_CONNECTION_REFUSED).
# Dev: http://localhost:8002 · Prod: your public https origin.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,applog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=devjourney
DB_USERNAME=devjourney
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Full-text search (Laravel Scout + Meilisearch)
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Filament admin panel path (https://APP_URL/admin by default)
FILAMENT_PATH=path
FILAMENT_ADMIN_EMAIL=tu@email.com

# Trusted reverse proxies. Comma-separated IPs/CIDRs. Use "*" only in local dev.
# Production: list your real proxies, e.g. TRUSTED_PROXIES=1.2.3.4,10.0.0.0/8
TRUSTED_PROXIES=*
ACME_EMAIL=tu@email.com

# ---- AI / RAG (Qdrant + LLM) ----
# Chat provider (OpenAI-compatible). For DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com  LLM_CHAT_MODEL=deepseek-chat
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
# Embeddings endpoint/model (OpenAI). Kept separate so you can pair OpenAI
# embeddings with a DeepSeek chat model.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_ENABLED=true
QDRANT_HOST=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=content
RAG_TOP_K=5
RAG_REQUESTS_PER_DAY=20
RAG_TOKENS_PER_DAY=20000
