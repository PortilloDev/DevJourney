APP_NAME=DevJourney
APP_ENV=local
APP_KEY=base64:Nw4hSPg5YNj1eC73JOYaRlyCnhGBMbvevPDbD9gl3hY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Canonical origin the browser uses (scheme://host[:port]). Laravel forces this
# as the root URL, so it MUST include the port in dev (e.g. http://localhost:8002)
# or links/redirects will point to http://localhost without it.
APP_URL=http://localhost

# Origin the browser uses to load assets. Docker delivers requests to the
# container with a portless Host, so without this asset() emits
# http://localhost/build/... and assets fail (ERR_CONNECTION_REFUSED).
# Dev: http://localhost:8002 · Prod: your public https origin.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,applog
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30
LOG_EXPORT_RETENTION_DAYS=90

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=devjourney
DB_USERNAME=devjourney
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Redis queue retry window (seconds). Keep it above the worker --timeout.
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Full-text search (Laravel Scout + Meilisearch)
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Filament admin panel path (https://APP_URL/admin by default)
FILAMENT_PATH=path
FILAMENT_ADMIN_EMAIL=tu@email.com

# Trusted reverse proxies. Comma-separated IPs/CIDRs. Use "*" only in local dev.
# Production: list your real proxies, e.g. TRUSTED_PROXIES=1.2.3.4,10.0.0.0/8
TRUSTED_PROXIES=*
ACME_EMAIL=tu@email.com

# ---- AI / RAG (Qdrant + LLM) ----
# Chat provider (OpenAI-compatible). For DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com  LLM_CHAT_MODEL=deepseek-chat
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
# Embeddings endpoint/model (OpenAI). Kept separate so you can pair OpenAI
# embeddings with a DeepSeek chat model.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_ENABLED=true
QDRANT_HOST=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=content
RAG_TOP_K=5
# Strict semantic floor, plus the more permissive floor applied when the
# question shares a distinctive term with the post title.
RAG_MIN_SIMILARITY=0.30
RAG_RELATED_MIN_SIMILARITY=0.20
# Score above which a low-coverage title-term question is still accepted.
RAG_CONFIDENT_SIMILARITY=0.65
# Content types that receive embeddings. Challenges and projects are not
# reachable by any retrieval path today, so they are excluded by default.
RAG_INDEXING_SOURCE_TYPES=post,document
RAG_REQUESTS_PER_DAY=20
# Site-wide ceiling on model chat calls per day, across all visitors.
RAG_GLOBAL_REQUESTS_PER_DAY=500
RAG_TOKENS_PER_DAY=20000
RAG_RETENTION_DAYS=30
# Raw browsing sessions are aggregated into daily_traffic and deleted after
# this many days by `analytics:prune`.
ANALYTICS_RETENTION_DAYS=90
# Answer/embedding cache TTL, in seconds (default 7 days).
RAG_CACHE_ANSWER_TTL=604800
RAG_CACHE_EMBEDDING_TTL=604800
# Conversational memory: model that rewrites a follow-up into a standalone
# question (empty falls back to LLM_CHAT_MODEL), its output cap, and how many
# previous turns are sent to the model as history.
RAG_REWRITE_MODEL=
RAG_REWRITE_MAX_TOKENS=60
RAG_CONVERSATION_MAX_TURNS=3
# Token budget for the history sent to the model (oldest turns are dropped).
RAG_CONVERSATION_MAX_TOKENS=600
# Store the full messages sent to the model (system + context + history).
# Disable to store only the system prompt and question.
RAG_LOG_FULL_PROMPT=true
# Provider circuit breaker: open after more than this many consecutive failures,
# for this many seconds.
RAG_CIRCUIT_THRESHOLD=5
RAG_CIRCUIT_COOLDOWN=300
# Provider call timeouts, in seconds. Keep nginx (fastcgi_read_timeout) and
# PHP-FPM (request_terminate_timeout) above these values.
RAG_TIMEOUT_COMPLETE=30
RAG_TIMEOUT_STREAM=30
RAG_GENERAL_MAX_ANSWER_TOKENS=400
